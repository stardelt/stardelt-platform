{
  "realm": "stardelt",
  "displayName": "stardelt",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "groups": [
    {
      "name": "stardelt-admins",
      "path": "/stardelt-admins",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups",
          "manage-users"
        ]
      }
    },
    {
      "name": "stardelt-users"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@__BASE_DOMAIN__",
      "emailVerified": true,
      "firstName": "stardelt",
      "lastName": "Admin",
      "groups": [
        "/stardelt-admins"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${STARDELT_REALM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-trino-group-sync",
      "enabled": true,
      "serviceAccountClientId": "trino-group-sync",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "service-account-pipeline-runner",
      "enabled": true,
      "serviceAccountClientId": "pipeline-runner"
    }
  ],
  "clients": [
    {
      "clientId": "nova",
      "name": "stardelt Nova",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${STARDELT_NOVA_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://__NOVA_HOST__/api/auth/callback"
      ],
      "webOrigins": [
        "https://__NOVA_HOST__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://__NOVA_HOST__/*"
      },
      "protocolMappers": [
        {
          "name": "aud-nova",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nova",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trino",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-lakekeeper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lakekeeper",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trino",
      "name": "Trino",
