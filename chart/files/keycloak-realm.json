    {
      "clientId": "trino-group-sync",
      "name": "Trino group sync",
      "description": "Continuous sync of the stardelt-admins group file (platform#167): a CronJob reads group membership through this client's service account. Read-only by design — exactly view-users on realm-management, no flows, no mappers, no redirect URIs.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${STARDELT_TRINO_GROUP_SYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {},
      "protocolMappers": []
    },
    {
      "clientId": "pipeline-runner",
      "name": "Pipeline runner",
      "description": "Service principal scheduled pipelines run as (scheduled jobs J0, platform#118): the pipeline loader fetches a client-credentials token for it and runs sql tasks on the query engine with it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${STARDELT_PIPELINE_RUNNER_CLIENT_SECRET}",
