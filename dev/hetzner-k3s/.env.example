# Copy to .env (gitignored) and fill in, or put these in the shell:
#   set -a; . ./.env; set +a
#
# Hetzner Cloud API token (Read & Write). Can also live in
# ~/.config/stardelt/hetzner.env, which provision.sh sources automatically.
HCLOUD_TOKEN=

# Cluster shape (all optional).
CLUSTER_NAME=stardelt-dev
K3S_VERSION=v1.37.1+k3s1
NODE_TYPE=cx33          # 4 vCPU / 8 GB (~EUR10/mo). cx43 = 8/16 GB (~EUR19/mo) for the full stack.
LOCATION=nbg1           # nbg1 | fsn1 | hel1 | ash | hil
# SSH_PUBLIC_KEY=$HOME/.ssh/id_ed25519.pub
# SSH_PRIVATE_KEY=$HOME/.ssh/id_ed25519
# KUBECONFIG_PATH=$HOME/.kube/stardelt-dev.yaml
# INGRESS_HOST=alpha.dev.stardelt.io
# ALLOW_IPV4 / ALLOW_IPV6 default to your current public addresses (/32, /128).
