# Copy to .env, fill in, then: set -a; . ./.env; set +a
HCLOUD_TOKEN=

# Optional overrides
NAME=stardelt-dev
TYPE=cx32           # 4 vCPU / 8 GB (~€7/mo). cx42 = 8 vCPU / 16 GB (~€16/mo) if pods OOM.
LOCATION=nbg1       # nbg1 | fsn1 | hel1 | ash | hil
IMAGE=ubuntu-24.04
# Playground hostname (A + wildcard A point at the dev node).
# INGRESS_HOST=alpha.dev.stardelt.io
# ALLOW_CIDR defaults to your current public IP /32 (recommended for SSH + API).
# SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub
